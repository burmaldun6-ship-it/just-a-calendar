# Predictable line endings across platforms; keep wrapper binaries intact.
* text=auto
*.md text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.apk binary
